# Safe defaults. Live publishing remains off until explicitly enabled.
RUN_LIGHTER_TIMEZONE=Australia/Sydney
RUN_LIGHTER_SITE_URL=https://runlighter.com
CAMPAIGN_START_DATE=
CAMPAIGN_DAYS=14
CONTINUOUS_CONTENT=false
CONTENT_STAGE_TIME=05:00
CONTENT_PUBLISH_TIME=07:00
AUTO_PUBLISH=false
INSTAGRAM_AUTO_PUBLISH=false
CONTENT_KILL_SWITCH=false
DRY_RUN=true
TOPIC_SIMILARITY_THRESHOLD=0.82
PROMOTION_THRESHOLD=80
MAX_RETRIES=3
PUBLISH_TIMEOUT_SECONDS=300
CAPTION_MIN_WORDS=80
CAPTION_MAX_WORDS=180
ARTICLE_MIN_WORDS=700
ARTICLE_MAX_WORDS=1300

# Providers: mock, openai, none
TEXT_PROVIDER=mock
IMAGE_PROVIDER=mock
RESEARCH_PROVIDER=none
OPENAI_API_KEY=
TEXT_MODEL=gpt-5.6
IMAGE_MODEL=gpt-image-2

# Meta Instagram Content Publishing API.
# META_API_VERSION is intentionally required for live mode so an obsolete
# Graph API version is never silently selected.
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_API_VERSION=

# Run Lighter Marketing Learning System.
# Account, campaign, ad set and form IDs are Run Lighter defaults in the
# business-specific repository and can be overridden here.
META_AD_ACCOUNT_ID=264193331473545
META_CAMPAIGN_ID=120252651440610735
META_AD_SET_ID=120252651440620735
META_LEAD_FORM_ID=1035154425566494
MARKETING_AGENT_DRY_RUN=true
MARKETING_AGENT_KILL_SWITCH=false
MARKETING_ALLOW_META_WRITES=false
MARKETING_LOOKBACK_DAYS=7
MARKETING_MINIMUM_SPEND=20
MARKETING_MINIMUM_IMPRESSIONS=1000
MARKETING_MINIMUM_AGE_HOURS=72
MARKETING_WINNER_LEAD_COUNT=2
MARKETING_MAXIMUM_PAUSE_RECOMMENDATIONS=4
RUN_LIGHTER_LEAD_CSV=
MARKETING_AGENT_SNAPSHOT=
MARKETING_LEAD_WEBHOOK_URL=
MARKETING_LEAD_WEBHOOK_SECRET=

# Optional notification adapter: none, github, webhook
NOTIFICATION_PROVIDER=github
NOTIFICATION_WEBHOOK_URL=
